{
  "name": "Plaid Dashboard",
  "short_name": "Plaid",
  "description": "Live status, charging, trips and health for a Model S Plaid.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04060A",
