# Copy to .env and fill in. docs/SETUP.md explains where each value comes from.

# --- App ---
PORT=8080
# The public HTTPS address of the dashboard. Tesla also fetches your public key from this domain.
PUBLIC_URL=https://plaid.example.com
# Used by Caddy in deploy/docker-compose.yml (the hostname part of PUBLIC_URL).
APP_DOMAIN=plaid.example.com
# Required outside sample mode: anyone with this passcode can unlock the car.
APP_PASSCODE=
# Signs the login cookie. Any long random string (openssl rand -hex 32).
SESSION_SECRET=
# 1 = simulated data, no Tesla account needed.
SAMPLE_MODE=0
VIN=

# --- Tesla developer app (developer.tesla.com) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Defaults to $PUBLIC_URL/auth/callback. Must match the redirect URI on developer.tesla.com.
TESLA_REDIRECT_URI=
# North America base URL. For other regions see developer.tesla.com/docs/fleet-api/getting-started/regions-countries
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com

# --- tesla-http-proxy (signs the telemetry config with your virtual key) ---
TESLA_PROXY_URL=https://localhost:4443
TESLA_PROXY_CA_FILE=deploy/config/proxy/tls-cert.pem
# Public half of the virtual key, served at /.well-known/appspecific/com.tesla.3p.public-key.pem
TESLA_PUBLIC_KEY_FILE=deploy/config/proxy/fleet-key-public.pem

# --- Fleet Telemetry server (the car connects here) ---
TELEMETRY_HOSTNAME=telemetry.example.com
TELEMETRY_PORT=8443
# Full certificate chain of the telemetry server's TLS certificate.
TELEMETRY_CA_FILE=deploy/config/telemetry/ca.pem
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_BASE=telemetry

# --- Web push (npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Garage Pi bridge (same value goes in the Pi's /etc/plaid-bridge.env) ---
BRIDGE_TOKEN=
# Optional read-only API token (openssl rand -hex 32): GET /api/* with "Authorization: Bearer <token>", no passcode.
READ_TOKEN=

# --- Your numbers ---
# Home electricity price per kWh; Tesla doesn't report it.
HOME_RATE_PER_KWH=
CURRENCY=USD
# Recommended cold tire pressure from the door-jamb placard, psi.
TIRE_TARGET_PSI=
